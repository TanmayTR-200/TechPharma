# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Configuration
MONGODB_URI=your_mongodb_uri_here

# PostgreSQL (primary database - hosted, so the app runs even when your
# machine is off). Supabase dashboard -> Project -> Connect -> Session pooler
# (port 5432) for the server; port 6543 also works for one-shot scripts.
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Hosted providers require TLS. Set false only for a local, non-TLS database.
PG_SSL=true
# Emergency rollback to the legacy JSON store.
PG_DISABLED=false

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Cloudinary Configuration (if using)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=https://your-vercel-app.vercel.app
