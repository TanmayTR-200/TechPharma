{
  "name": "techpharma-backend",
  "version": "1.0.0",
  "description": "Backend API for TechPharma B2B Platform",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "db:migrate": "node src/db/migrate.js",
